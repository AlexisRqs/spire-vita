+	 * keeps whole-atlas duplicates alive until frame purge, even within one
+	 * long loading frame. Preserve the allocation and avoid that amplification.
+	 * glFinish flushes an open scene; the explicit fence also covers previously
+	 * submitted scenes when scene_not_flushed is false. */
 	if (tex->last_frame != OBJ_NOT_USED && (vgl_framecount - tex->last_frame <= FRAME_PURGE_FREQ)) {
-		uint32_t size;
-		if (tex->mip_count > 1) {
-			po2_w = nearest_po2(orig_w);
-			po2_h = nearest_po2(orig_h);
-			uint32_t w = po2_w;
-			uint32_t h = po2_h;
-			size = 0;
-			for (int j = 0; j < tex->mip_count; j++) {
-				jumps[j] = MAX(w, 8) * h * bpp;
-				w /= 2;
-				h /= 2;
-				size += jumps[j];
-			}
-		} else {
-			size = orig_h * VGL_ALIGN(orig_w, 8) * bpp;
-		}
-		void *texture_data = gpu_alloc_mapped_for_gpu(size);
-		vgl_fast_memcpy(texture_data, tex->data, size);
-		gpu_free_texture_data(tex);
-		sceGxmTextureSetData(&tex->gxm_tex, texture_data);
-		tex->data = texture_data;
+		glFinish();
+		sceGxmFinish(gxm_context);
 		tex->last_frame = OBJ_NOT_USED;
-#ifdef HAVE_TEX_CACHE
-		mark_as_cacheable(tex)
-#endif
 	}
 #endif
+
+	/* Failed texture allocation/redefinition must never become memcpy(NULL). */
+	if (!tex->data) {
+		SET_GL_ERROR(GL_OUT_OF_MEMORY)
+	}
 	// Calculating start address of requested texture modification
 	uint8_t *ptr = (uint8_t *)tex->data;
 	uint8_t data_bpp = 0;
